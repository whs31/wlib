#pragma once

// NOLINTBEGIN(cppcoreguidelines-macro-usage, readability-use-concise-preprocessor-directives)

#cmakedefine W_COMMON_WITH_GLAZE

#if defined(NDEBUG)
#  define W_NO_DEBUG
#else
#  define W_DEBUG
#endif

#if defined(W_VERSION_ENCODE)
#  undef W_VERSION_ENCODE
#endif
#define W_VERSION_ENCODE(major,minor,patch) (((major) * 1000000) + ((minor) * 1000) + (patch))

#if defined(W_VERSION_DECODE_MAJOR)
#  undef W_VERSION_DECODE_MAJOR
#endif
#define W_VERSION_DECODE_MAJOR(version) ((version) / 1000000)

#if defined(W_VERSION_DECODE_MINOR)
#  undef W_VERSION_DECODE_MINOR
#endif
#define W_VERSION_DECODE_MINOR(version) (((version) % 1000000) / 1000)

#if defined(W_VERSION_DECODE_PATCH)
#  undef W_VERSION_DECODE_PATCH
#endif
#define W_VERSION_DECODE_PATCH(version) ((version) % 1000)

#if defined(W_STRINGIFY_EX)
#  undef W_STRINGIFY_EX
#endif
#define W_STRINGIFY_EX(x) #x

#if defined(W_STRINGIFY)
#  undef W_STRINGIFY
#endif
#define W_STRINGIFY(x) W_STRINGIFY_EX(x)

#if defined(W_CONCAT_EX)
#  undef W_CONCAT_EX
#endif
#define W_CONCAT_EX(a,b) a##b

#if defined(W_CONCAT)
#  undef W_CONCAT
#endif
#define W_CONCAT(a,b) W_CONCAT_EX(a,b)

#if defined(W_CONCAT3_EX)
#  undef W_CONCAT3_EX
#endif
#define W_CONCAT3_EX(a,b,c) a##b##c

#if defined(W_CONCAT3)
#  undef W_CONCAT3
#endif
#define W_CONCAT3(a,b,c) W_CONCAT3_EX(a,b,c)

#ifdef __cplusplus
#  define W_C_DECL extern "C"
#  define W_EXTERN_C_BEGIN extern "C" {
#  define W_EXTERN_C_END }
#else
#  define W_C_DECL
#  define W_EXTERN_C_BEGIN
#  define W_EXTERN_C_END
#endif

#define W_C_FORWARD_DECLARE(TYPE) W_EXTERN_C_BEGIN TYPE; W_EXTERN_C_END

// NOLINTEND(cppcoreguidelines-macro-usage, readability-use-concise-preprocessor-directives)

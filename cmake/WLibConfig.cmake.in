@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(fmt REQUIRED)
find_dependency(spdlog REQUIRED)

# The glaze component (w::lib::glaze) is found only if the package was built with it. The Qt
# integration is the separate package WLibQt.
if(@WLIB_WITH_GLAZE@ AND "glaze" IN_LIST WLib_FIND_COMPONENTS)
  find_dependency(glaze REQUIRED)
  set(WLib_glaze_FOUND TRUE)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/WLibTargets.cmake")

check_required_components(WLib)
